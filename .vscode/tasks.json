{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "啟動資料轉換助理 Backend",
      "type": "process",
      "command": "mvn",
      "args": ["spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "lineage-backend",
        "pattern": {
          "regexp": "^\\[ERROR\\] (.*\\.java):\\[(\\d+),(\\d+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "endsPattern": "^.*Started LineageSearchApplication.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "group": "build"
    },
    {
      "label": "啟動資料轉換助理 Frontend",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "lineage-frontend",
        "pattern": {
          "regexp": "^\\s*([^:]+):(\\d+):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "endsPattern": "^.*Local:.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "啟動資料轉換助理 全端",
      "dependsOn": [
        "啟動資料轉換助理 Backend",
        "啟動資料轉換助理 Frontend"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
