CREATE OR REPLACE PACKAGE PKG_CONTRACT_INTAKE AS
    PROCEDURE RUN_EXTRACT;
    PROCEDURE LOAD_SOURCE_ROWS;
END PKG_CONTRACT_INTAKE;
/
CREATE OR REPLACE PACKAGE BODY PKG_CONTRACT_INTAKE AS
    PROCEDURE RUN_EXTRACT IS
    BEGIN
        LOAD_SOURCE_ROWS;
    END RUN_EXTRACT;

    PROCEDURE LOAD_SOURCE_ROWS IS
    BEGIN
        INSERT INTO STG_AGREEMENT (
            CONTRACT_KEY,
            PARTY_KEY,
            PARTY_LABEL,
            CONTRACT_STATE,
            SOURCE_BEGIN_ON,
            REQUESTED_BEGIN_ON,
            CHECK_RESULT,
            ARCHIVE_BEGIN_ON
        )
        SELECT a.CONTRACT_KEY,
               a.PARTY_KEY,
               NVL(p.PARTY_NAME, 'UNKNOWN PARTY'),
               a.CONTRACT_STATE,
               a.COVERAGE_BEGIN_ON,
               a.REQUESTED_BEGIN_ON,
               CAST(NULL AS VARCHAR2(20)),
               a.ARCHIVE_BEGIN_ON
          FROM RAW_AGREEMENT a
          LEFT JOIN RAW_PARTY p ON p.PARTY_KEY = a.PARTY_KEY;
    END LOAD_SOURCE_ROWS;
END PKG_CONTRACT_INTAKE;
/
