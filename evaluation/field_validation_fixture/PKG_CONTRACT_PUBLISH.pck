CREATE OR REPLACE PACKAGE PKG_CONTRACT_PUBLISH AS
    PROCEDURE RUN_PUBLISH;
    PROCEDURE MERGE_TARGET_ROWS;
END PKG_CONTRACT_PUBLISH;
/
CREATE OR REPLACE PACKAGE BODY PKG_CONTRACT_PUBLISH AS
    PROCEDURE RUN_PUBLISH IS
    BEGIN
        PKG_CONTRACT_RULES.RUN_TRANSFORM;
        MERGE_TARGET_ROWS;
    END RUN_PUBLISH;

    PROCEDURE MERGE_TARGET_ROWS IS
    BEGIN
        MERGE INTO TGT_AGREEMENT t
        USING (
            SELECT CONTRACT_KEY, PARTY_LABEL, CALCULATED_BEGIN_ON
              FROM STG_AGREEMENT_READY
        ) s
        ON (t.CONTRACT_KEY = s.CONTRACT_KEY)
        WHEN MATCHED THEN UPDATE SET
            t.PARTY_LABEL = s.PARTY_LABEL,
            t.COVERAGE_BEGIN_DATE = s.CALCULATED_BEGIN_ON
        WHEN NOT MATCHED THEN INSERT (
            CONTRACT_KEY,
            PARTY_LABEL,
            COVERAGE_BEGIN_DATE
        ) VALUES (
            s.CONTRACT_KEY,
            s.PARTY_LABEL,
            s.CALCULATED_BEGIN_ON
        );
    END MERGE_TARGET_ROWS;
END PKG_CONTRACT_PUBLISH;
/
