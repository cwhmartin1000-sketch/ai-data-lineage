CREATE OR REPLACE PACKAGE PKG_CONTRACT_SCREEN AS
    PROCEDURE RUN_SCREENING;
    PROCEDURE CHECK_STAGED_ROWS;
END PKG_CONTRACT_SCREEN;
/
CREATE OR REPLACE PACKAGE BODY PKG_CONTRACT_SCREEN AS
    PROCEDURE RUN_SCREENING IS
    BEGIN
        CHECK_STAGED_ROWS;
    END RUN_SCREENING;

    PROCEDURE CHECK_STAGED_ROWS IS
    BEGIN
        FOR r IN (
            SELECT CONTRACT_KEY, CONTRACT_STATE, SOURCE_BEGIN_ON, CHECK_RESULT
              FROM STG_AGREEMENT
        ) LOOP
            IF r.CONTRACT_KEY IS NULL THEN
                UPDATE STG_AGREEMENT s
                   SET CHECK_RESULT = NVL(s.CHECK_RESULT, 'REJECT_KEY')
                 WHERE s.CONTRACT_KEY IS NULL;
            ELSIF r.SOURCE_BEGIN_ON IS NULL THEN
                UPDATE STG_AGREEMENT s
                   SET CHECK_RESULT = NVL(s.CHECK_RESULT, 'REJECT_BEGIN_DATE')
                 WHERE s.CONTRACT_KEY = r.CONTRACT_KEY;
            ELSIF r.CONTRACT_STATE NOT IN ('ACTIVE', 'PENDING') THEN
                UPDATE STG_AGREEMENT s
                   SET CHECK_RESULT = NVL(s.CHECK_RESULT, 'REVIEW_STATE')
                 WHERE s.CONTRACT_KEY = r.CONTRACT_KEY;
            ELSIF r.SOURCE_BEGIN_ON > TRUNC(SYSDATE) THEN
                UPDATE STG_AGREEMENT s
                   SET CHECK_RESULT = NVL(s.CHECK_RESULT, 'FUTURE_BEGIN')
                 WHERE s.CONTRACT_KEY = r.CONTRACT_KEY;
            ELSE
                UPDATE STG_AGREEMENT s
                   SET CHECK_RESULT = NVL(s.CHECK_RESULT, 'READY')
                 WHERE s.CONTRACT_KEY = r.CONTRACT_KEY;
            END IF;
        END LOOP;
    END CHECK_STAGED_ROWS;
END PKG_CONTRACT_SCREEN;
/

