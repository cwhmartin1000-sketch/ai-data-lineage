CREATE OR REPLACE PACKAGE BODY PKG_POLICY_EXTRACT AS

    PROCEDURE RUN_EXTRACT IS
    BEGIN
        LOAD_SOURCE_TO_STAGE;
    END RUN_EXTRACT;

    PROCEDURE LOAD_SOURCE_TO_STAGE IS
    BEGIN
        DELETE FROM STG_POLICY;

        INSERT INTO STG_POLICY (
            POLICY_NO,
            START_DATE,
            REQUESTED_START_DATE,
            POLICY_STATUS,
            CUSTOMER_NAME,
            PRODUCT_TYPE
        )
        SELECT p.POLICY_ID,
               TO_DATE(TO_CHAR(p.POLICY_START_DT, 'YYYY-MM-DD'), 'YYYY-MM-DD'),
               CASE
                   WHEN p.REQUESTED_EFFECTIVE_DT IS NOT NULL
                       THEN TO_DATE(TO_CHAR(p.REQUESTED_EFFECTIVE_DT, 'YYYY-MM-DD'), 'YYYY-MM-DD')
                   ELSE NULL
               END,
               p.POLICY_STATUS,
               NVL(c.CUSTOMER_NAME, 'UNKNOWN CUSTOMER'),
               NVL(pr.PRODUCT_TYPE, 'UNKNOWN PRODUCT')
          FROM SRC_POLICY p
          JOIN SRC_CUSTOMER c ON c.CUSTOMER_ID = p.CUSTOMER_ID
          JOIN SRC_PRODUCT pr ON pr.PRODUCT_CODE = p.PRODUCT_CODE;
    END LOAD_SOURCE_TO_STAGE;

END PKG_POLICY_EXTRACT;
/
